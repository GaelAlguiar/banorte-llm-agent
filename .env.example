OPENAI_API_KEY=
AGENT_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_PROFESSIONAL_CLASSIFIER_MODEL=gpt-5.6
# Opcional: usa OPENAI_MODEL si se omite.
OPENAI_PRIVACY_CLASSIFIER_MODEL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=cv-profile-v1
AZURE_SEARCH_MIN_SCORE=0.03
# Entre 0 y 4. Una allowlist vacía bloquea todos los adjuntos.
MAX_ATTACHMENTS=4
ATTACHMENT_TRUSTED_HOSTS=
# Límite del JSON de /v1/responses: entre 65536 y 2097152 bytes.
MAX_REQUEST_BODY_BYTES=1048576
# Opcional: configura ambos valores sólo si el portal entrega una credencial
# de lectura dedicada para sus referencias opacas de archivo.
PARLEY_FILE_BASE_URL=
PARLEY_FILE_BEARER_TOKEN=
PARLEY_FILE_CAPABILITY_SCOPE=
PARLEY_FILE_MAX_BYTES=10485760
APP_ENV=local
