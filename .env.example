OPENAI_API_KEY=
AGENT_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_PROFESSIONAL_CLASSIFIER_MODEL=gpt-5.6
# Opcional: usa OPENAI_MODEL si se omite.
OPENAI_PRIVACY_CLASSIFIER_MODEL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=cv-profile-v1
AZURE_SEARCH_MIN_SCORE=0.03
# Entre 0 y 4. Un allowlist vacío permite cualquier FQDN público sintáctico.
MAX_ATTACHMENTS=4
TRUSTED_ATTACHMENT_HOSTS=
APP_ENV=local
